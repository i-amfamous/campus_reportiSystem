# ---------------------------------------------------------------------------
# Campus Resolve — environment template
# Copy to `.env` (root) or `apps/api/.env` and adjust for your environment.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the React web application. Used to build links inside emails.
APP_URL=http://localhost:5173
# Public URL of this API.
API_URL=http://localhost:4000
# Comma separated list of allowed browser origins for the API (CORS + CSRF).
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy/load balancer (nginx, Heroku, etc.)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://campus_resolve:campus_resolve@localhost:5433/campus_resolve?schema=public
# Connection string used by the test suite (a dedicated database is recommended).
TEST_DATABASE_URL=postgresql://campus_resolve:campus_resolve@localhost:5433/campus_resolve_test?schema=public

# --- Institution -------------------------------------------------------------
INSTITUTION_NAME=Ghana Communication Technology University
# Institutional student email domains (comma separated). Students MUST use one.
INSTITUTION_EMAIL_DOMAINS=live.gctu.edu.gh
SUPPORT_EMAIL=support@campusresolve.edu.gh

# --- Sessions & security -----------------------------------------------------
SESSION_COOKIE_NAME=campus_session
CSRF_COOKIE_NAME=campus_csrf
SESSION_TTL_HOURS=12
# Used to derive session/CSRF token hashes. Must be a long random string.
SESSION_SECRET=c0d023f759a9917302299a47314c9d5bd517b42fe9360cdee083f5524ad743ffc3c82fd58628814e88c96b27c54d7519
# Set to true to require a second factor for privileged roles (see docs/security.md)
MFA_REQUIRED_FOR_PRIVILEGED=false

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX=5

# --- Email -------------------------------------------------------------------
# `console` writes the rendered message to the database and the log (dev/staging).
# `resend` uses the Resend HTTP API.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Campus Resolve
EMAIL_FROM_ADDRESS=no-reply@campusresolve.edu.gh
RESEND_API_KEY=
EMAIL_RETRY_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=60000

# --- Attachments (private storage, never publicly served) ---------------------
STORAGE_DIR=./storage/attachments
STORAGE_MAX_FILE_SIZE_MB=10

# --- Reminders, service targets & escalation --------------------------------
# Default staff reminder interval in minutes (the "two hour" rule).
REMINDER_INTERVAL_MINUTES=120
# Number of unanswered reminders before a ticket is escalated to the department head.
ESCALATION_AFTER_REMINDERS=3
# Maximum reminders per action cycle before reminders stop for that cycle.
MAX_REMINDERS=8
# Minutes a ticket may wait for a first response (service target).
SLA_FIRST_RESPONSE_MINUTES=480
# Minutes a ticket may take to reach resolution (service target).
SLA_RESOLUTION_MINUTES=4320
# Days after resolution before a resolved ticket may be auto-closed.
AUTO_CLOSE_DAYS=14

# --- Background worker -------------------------------------------------------
# Poll interval for the database-backed job queue (milliseconds).
WORKER_POLL_INTERVAL_MS=30000
# Batch size per tick.
WORKER_BATCH_SIZE=25
# Maximum attempts for a job before it is marked FAILED.
WORKER_MAX_ATTEMPTS=5
# Worker instance id (leave blank to auto-generate).
WORKER_ID=

# --- Seed / bootstrap --------------------------------------------------------
# Super administrator created by the seed script.
BOOTSTRAP_ADMIN_EMAIL=superadmin@live.gctu.edu.gh
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_NAME=Platform Super Administrator
