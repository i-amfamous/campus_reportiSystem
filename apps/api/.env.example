# ---------------------------------------------------------------------------
# Campus Resolve — API environment
# Copy to `apps/api/.env` and adjust. Root `.env` values are used as fallback
# when this file is absent.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

DATABASE_URL=postgresql://campus_resolve:campus_resolve@localhost:5433/campus_resolve?schema=public
TEST_DATABASE_URL=postgresql://campus_resolve:campus_resolve@localhost:5433/campus_resolve_test?schema=public

INSTITUTION_NAME=Ghana Communication Technology University
INSTITUTION_EMAIL_DOMAINS=live.gctu.edu.gh
SUPPORT_EMAIL=2425400074@live.gctu.edu.gh

SESSION_COOKIE_NAME=campus_session
CSRF_COOKIE_NAME=campus_csrf
# The Secure cookie flag. Defaults to true in production. Set to false only
# for a plain-HTTP deployment, otherwise the browser refuses the cookie.
COOKIE_SECURE=
SESSION_TTL_HOURS=12
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX=5

EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Campus Resolve
EMAIL_FROM_ADDRESS=no-reply@campusresolve.edu.gh
RESEND_API_KEY=
EMAIL_RETRY_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=60000

STORAGE_DIR=./storage/attachments
STORAGE_MAX_FILE_SIZE_MB=10

REMINDER_INTERVAL_MINUTES=120
ESCALATION_AFTER_REMINDERS=3
MAX_REMINDERS=8
SLA_FIRST_RESPONSE_MINUTES=480
SLA_RESOLUTION_MINUTES=4320
AUTO_CLOSE_DAYS=14

WORKER_POLL_INTERVAL_MS=30000
WORKER_BATCH_SIZE=25
WORKER_MAX_ATTEMPTS=5
WORKER_ID=

BOOTSTRAP_ADMIN_EMAIL=2425400074@live.gctu.edu.gh
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_NAME=Platform Super Administrator
